{$CODER_DOMAIN} {
	encode gzip
	log {
		output stdout
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	@metrics path /api/v1/metrics
	respond @metrics "Not Found" 404
	reverse_proxy cloud:8080
}
