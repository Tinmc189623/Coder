# .NET
bin/
obj/
*.user
*.suo
.vs/

# archive（历史归档，不进版本库）
archive/

# Node (legacy TypeScript implementation under archive/)
node_modules/
build/
*.tsbuildinfo
.bun-build

# release staging (never committed):
#   dist/artifacts  — final deliverables (msix / installer / cert)
#   dist/notes      — release notes
#   dist/work       — intermediate build output
dist/

# logs & env
*.log
.env
.env.local
.env.*.local

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# local config & caches
coverage/
.nyc_output/
.cache/
config.local.json
config.local.yaml
coder.config.local.*
.mavis-trash/

# agent workspace notes (local tooling, not project content)
.workbuddy/

# local Claude Code guidance & runtime state (per-machine, not project content)
CLAUDE.md
.claude/

# smoke suite (internal tooling, not shipped with the repo)
tests/*.py

# installer payload (copied from dist/publish at build time)
installer/payload/
installer-winui3/payload/

# code-signing certificate material — never commit, even if dist/ rules change
*.pfx
*.cer
*.p12
