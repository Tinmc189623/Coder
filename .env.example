# docker compose 读取此文件。复制为 .env 后填入真实值，不要提交 .env。
# 生成方式（PowerShell 7）：[Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
POSTGRES_PASSWORD=
CODER_CLOUD_JWT_SECRET=
CODER_CLOUD_ADMIN_API_KEY=

# Caddy 对外域名；本机验证可用 localhost。
CODER_DOMAIN=coder.example.com

# 可选：云端模型代理。三项都留空时代理关闭。
CODER_CLOUD_MODEL__BASE_URL=
CODER_CLOUD_MODEL__MODEL=
CODER_CLOUD_MODEL__API_KEY=
