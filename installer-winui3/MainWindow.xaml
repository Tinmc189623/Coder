<Window
    x:Class="Coder.Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Coder CLI Installer">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部品牌区:电光紫渐变 -->
        <Grid Grid.Row="0" Background="#6A4A96" Padding="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE7C4;" FontSize="40" Foreground="White" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Coder CLI" FontSize="26" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="production-grade AI coding agent for the terminal" Foreground="#D7C8F0" />
            </StackPanel>
        </Grid>

        <!-- 中部:页面容器 -->
        <ContentControl x:Name="PageHost" Grid.Row="1" />

        <!-- 底部按钮区 -->
        <Grid Grid.Row="2" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SecondaryButton" Grid.Column="1" Content="取消" MinWidth="96" Margin="0,0,12,0"
                    Click="OnSecondaryClick" />
            <Button x:Name="PrimaryButton" Grid.Column="2" Content="下一步" MinWidth="120" Style="{StaticResource AccentButtonStyle}"
                    Click="OnPrimaryClick" />
        </Grid>
    </Grid>
</Window>
