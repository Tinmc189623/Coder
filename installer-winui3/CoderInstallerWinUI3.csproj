<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Coder.Installer</RootNamespace>
    <AssemblyName>coder-setup</AssemblyName>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyTitle>Coder CLI Installer</AssemblyTitle>
    <AssemblyDescription>Coder CLI — one-click installer (Nexsteaduser)</AssemblyDescription>
    <Version>0.3.1</Version>
    <Authors>Nexsteaduser</Authors>
    <Company>Nexsteaduser</Company>
    <Copyright>Copyright © 2026 Nexsteaduser. All Rights Reserved.</Copyright>
    <ApplicationIcon>..\logo.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Windows App SDK (WinUI 3) + Tomlyn (payload 无关,安装器自身不用) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
  </ItemGroup>

  <!-- 发布产物作为嵌入资源随安装器一起分发 -->
  <ItemGroup>
    <EmbeddedResource Include="payload\coder.exe" LogicalName="payload.coder.exe" />
    <EmbeddedResource Include="payload\coder.dll" LogicalName="payload.coder.dll" />
    <EmbeddedResource Include="payload\coder.deps.json" LogicalName="payload.coder.deps.json" />
    <EmbeddedResource Include="payload\coder.runtimeconfig.json" LogicalName="payload.coder.runtimeconfig.json" />
    <EmbeddedResource Include="payload\Tomlyn.dll" LogicalName="payload.Tomlyn.dll" />
  </ItemGroup>

</Project>
