<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Coder</RootNamespace>
    <AssemblyName>coder</AssemblyName>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyTitle>Coder CLI</AssemblyTitle>
    <AssemblyDescription>Coder CLI — production-grade AI coding agent for the terminal (.NET 11)</AssemblyDescription>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <Version>0.2.3</Version>
    <Authors>Nexsteaduser</Authors>
    <Company>Nexsteaduser</Company>
    <Copyright>Copyright © 2026 Nexsteaduser. All Rights Reserved.</Copyright>
    <PackageId>coder-cli</PackageId>
  </PropertyGroup>

  <!--
    The project file lives at the repository root, so the SDK's default
    "**/*.cs" glob would otherwise sweep in stray sources from the archived
    TypeScript tree and from vendored Node/npm payloads (e.g.
    build/node-v20.18.0-win-x64/.../Find-VisualStudio.cs). Compile only src/.
  -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);archive/**;node_modules/**;dist/**;build/**;.workbuddy/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

</Project>
